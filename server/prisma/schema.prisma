datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             Int      @id @default(autoincrement())
  username       String   @unique
  profilePicture String?
  email          String   @unique
  hashedPassword String?
  authProvider   AuthProvider  @default(email)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  activity       Activity[]
  macros         Macros[]
  healthRecord   HealthRecord[]
  library        Book[]
}

enum AuthProvider {
  email
  google
  github
  apple
  facebook
  microsoft
  twitter
  gitlab
  discord
}

model Post {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  content     String
  coverImage  String?
  tags        TagOnPost[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([userId])
}

model Tag {
  id          Int      @id @default(autoincrement())
  content     String   @unique
  color       String
  category    Category?
  posts       TagOnPost[]
}

enum Category {
  coding
  fitness
  reading
  creativity
}

model TagOnPost {
  postId      Int
  tagId       Int
  post        Post     @relation(fields: [postId], references: [id])
  tag         Tag      @relation(fields: [tagId], references: [id])
  @@id([postId, tagId])
  @@index([postId])
  @@index([tagId])
}

model Activity {
  id          Int       @id @default(autoincrement())
  date        DateTime  @db.Date
  userId      Int
  intensity   Int
  details     Json?
  image       String?
  description String?
  type        ActivityType
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user User @relation(fields: [userId], references: [id])
  @@index([userId, date])
}

enum ActivityType {
  workout
  calorie_deficit
  reading
  coding
}

model Macros {
  id          Int @id @default(autoincrement())
  userId      Int
  protein     Int
  carbs       Int
  fat         Int
  caloriesIn  Int
  caloriesOut Int?
  date        DateTime @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
  @@index([userId, date])
}

model HealthRecord {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  weight      Decimal?   // kg
  weightGoal  Decimal?   // kg
  height      Float?   // cm
  recordedAt  DateTime @default(now())
  notes       String? 
  @@index([userId, recordedAt])
}

model Book {
  id          Int      @id @default(autoincrement())
  userId      Int
  name        String
  picture     String?
  progress    Int      @default(0)
  author      String?
  lastRead    DateTime?
  completed   Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}